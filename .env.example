# Copy this file to .env and fill in real values. .env is gitignored and never committed.

SECRET_KEY=change-me
DEBUG=True

# Local Postgres (used by DATABASES in settings.py)
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# Supabase (hosted Postgres / REST API, if you point DATABASES at it instead)
DATABASE_URL=
SUPABASE_URL=

# createsuperuser bootstrap credentials
DJANGO_SUPERUSER_USERNAME=
DJANGO_SUPERUSER_EMAIL=
DJANGO_SUPERUSER_PASSWORD=
